# OneMap Singapore API Credentials (Member 2: Geospatial Engine)
# Get free account from https://www.onemap.gov.sg/apidocs/
ONEMAP_EMAIL=your_email@example.com
ONEMAP_PASSWORD=your_password

# OpenAI API Key (Members 1, 3, 4, 5: Supervisor LLM, SQL Agent, Policy RAG, Guardrails)
# Proposal specifies: gpt-4o-mini, text-embedding-3-small (temp=0.0, seed=42)
OPENAI_API_KEY=your_openai_api_key_here

# Member 4: LLM profile selection (see config/experiment_config.yaml -> llm.profiles)
# ollama = local dev | vllm = SCIS GPU cluster via cluster/tunnel.sh | none = deterministic, no model
LLM_PROFILE=ollama
# VLLM_API_KEY is written here automatically by cluster/tunnel.sh (key of your own vLLM job)
# VLLM_API_KEY=
# Your own cluster login, used by cluster/tunnel.sh (each member uses their own account):
# CLUSTER_LOGIN=<your-cluster-id>@<cluster-address>
# Optional overrides (used for the cluster endpoint once sized):
# LLM_BASE_URL=http://localhost:8001/v1
# LLM_MODEL=Qwen/Qwen3-30B-A3B-GPTQ-Int4

# LangSmith tracing (proposal §6.2) — leave LANGSMITH_TRACING=false if no key
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hdb-compass
