# Copy to .env. Environment variables override values in .env.
# Optional data.gov.sg key; leave blank for unauthenticated access.
DATA_GOV_SG_API_KEY=
# Database path relative to the repository root.
HDB_COMPASS_DB_PATH=data/local/hdb_compass.duckdb

# OneMap credentials: https://www.onemap.gov.sg/apidocs/
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Hosted model credentials; only the selected provider's key is used.
OPENAI_API_KEY=
GROQ_API_KEY=
# Google AI Studio key (https://aistudio.google.com); GOOGLE_API_KEY is accepted as a fallback.
GEMINI_API_KEY=
LLM_API_KEY=

# LLM profiles: config/experiment_config.yaml -> llm.profiles
# ollama | vllm | groq | openai | gemini | compatible | auto | none
LLM_PROFILE=ollama
OLLAMA_MODEL=qwen3:14b
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-3.5-flash-lite
# Client-side rate limits for the ACTIVE profile (override config/hosted_models.yaml rate_limits).
# Empty = use the profile default; 0 = unlimited. Defaults are per model (config/hosted_models.yaml model_rate_limits).
LLM_RPM=
LLM_TPM=
LLM_RPD=
# Longest a call may wait for a free slot before failing with a clear error (seconds, default 60).
LLM_RATE_LIMIT_MAX_WAIT_S=
# Do not set LLM_RPM=0 for a free-tier key: 0 turns pacing off and the provider answers with 429 errors.
# Experiment 2E judges (evaluation/run_rag_ablation.py): profiles from another model family than the app's, so no
# model grades its own answers. Their key comes from the profile's key variable (GROQ_API_KEY) unless
# LLM_JUDGE_API_KEY is set. Faithfulness / answer relevancy:
LLM_JUDGE_PROFILE=groq
LLM_JUDGE_MODEL=openai/gpt-oss-120b
# Context recall / precision (grade the retrieved passages, so a smaller model):
LLM_RETRIEVAL_JUDGE_PROFILE=groq
LLM_RETRIEVAL_JUDGE_MODEL=openai/gpt-oss-20b
# Paid Groq tier: skip the app's free-tier pacing for the judges and raise the per-request cap. On the free tier leave
# both unset: a request over ~6,500 tokens is then judged by the app's model (recorded per row) and each judge model
# stops at 200,000 tokens a day (the next run resumes).
# LLM_JUDGE_PAID_TIER=true
# LLM_JUDGE_MAX_PROMPT_TOKENS=124000
# Generator models 2E compares on RAG-2's passages (profile:model; the first is the app's). Not OpenAI models: the
# judges are OpenAI's gpt-oss, and no model should grade its own family's answers.
# LLM_E2E_GENERATORS=gemini:gemini-3.5-flash-lite,gemini:gemini-3.5-flash,groq:qwen/qwen3.8-27b
# auto tries these in order and retains the first available model until restart.
# LLM_AUTO_PROFILES=ollama,groq,openai
# cluster/tunnel.sh writes VLLM_API_KEY to .env.
# VLLM_API_KEY=
# Cluster login used by cluster/tunnel.sh:
# CLUSTER_LOGIN=<your-cluster-id>@<cluster-address>
# Optional model endpoint overrides:
# LLM_BASE_URL=http://localhost:8001/v1
# LLM_MODEL=Qwen/Qwen3-30B-A3B-GPTQ-Int4

# Optional LangSmith tracing (https://smith.langchain.com). Check it with: python -m agents.tracing --check
# If the key or destination is refused the app turns tracing off at start-up with one log line (no per-question errors).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# The API endpoint must match the region the key was created in, or every call is a 403:
#   US (default, leave unset): https://api.smith.langchain.com     EU: https://eu.api.smith.langchain.com
#   APAC: https://apac.api.smith.langchain.com                     self-hosted: your own URL
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
# Only for an organisation-scoped key: the workspace id.
# LANGSMITH_WORKSPACE_ID=
# Where runs land: choose ONE of the two ways below, never both.
#  (1) A plain project (simplest):
LANGSMITH_PROJECT=hdb-compass
#  (2) An agent address (runs go to that agent's environment project, e.g. hdb-compass-local). Set BOTH variables
#      and remove LANGSMITH_PROJECT above:
# LANGSMITH_AGENT_ID=hdb-compass
# LANGSMITH_AGENT_ENVIRONMENT=local
# Pitfalls (langsmith 0.14.x): only one of the two agent variables set, or an agent address together with
# LANGSMITH_PROJECT, leaves every run untraced; --check and the start-up log say which.
