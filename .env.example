# Copy to .env. Environment variables override values in .env.
# Optional data.gov.sg key; leave blank for unauthenticated access.
DATA_GOV_SG_API_KEY=
# Database path relative to the repository root.
HDB_COMPASS_DB_PATH=data/local/hdb_compass.duckdb

# OneMap credentials: https://www.onemap.gov.sg/apidocs/
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Hosted model credentials; only the selected provider's key is used.
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_API_KEY=

# LLM profiles: config/experiment_config.yaml -> llm.profiles
# ollama | vllm | groq | openai | compatible | auto | none
LLM_PROFILE=ollama
OLLAMA_MODEL=qwen3:14b
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_MODEL=gpt-4.1-mini
# auto tries these in order and retains the first available model until restart.
# LLM_AUTO_PROFILES=ollama,groq,openai
# cluster/tunnel.sh writes VLLM_API_KEY to .env.
# VLLM_API_KEY=
# Cluster login used by cluster/tunnel.sh:
# CLUSTER_LOGIN=<your-cluster-id>@<cluster-address>
# Optional model endpoint overrides:
# LLM_BASE_URL=http://localhost:8001/v1
# LLM_MODEL=Qwen/Qwen3-30B-A3B-GPTQ-Int4

# Optional LangSmith tracing (https://smith.langchain.com). Check it with: python -m agents.tracing --check
# If the key is refused the app turns tracing off at start-up with one log line (no per-question errors).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Separate projects keep app traces apart from evaluation runs: hdb-compass-local for the app and demos,
# hdb-compass-eval for evaluation runs (experiments are named from it).
LANGSMITH_PROJECT=hdb-compass-local
# Only if the account is not in the US region or is self-hosted (the EU region is https://eu.api.smith.langchain.com):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Only for an organisation-scoped key: the workspace id.
# LANGSMITH_WORKSPACE_ID=
# DO NOT set any LANGSMITH_AGENT_* variable (e.g. LANGSMITH_AGENT_ENVIRONMENT): the installed langsmith treats it as
# beta "agent address" routing, which fails every run and leaves it untraced.
